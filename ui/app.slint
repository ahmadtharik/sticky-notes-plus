import { Button, CheckBox, ComboBox, LineEdit, ScrollView, Switch, Palette } from "std-widgets.slint";

export struct NoteCard {
    id: string,
    title: string,
    preview: string,
    // Second preview line; each line is elided rather than clipped.
    preview-more: string,
    color: color,
    pinned: bool,
    updated-label: string,
}

export struct InlineRun {
    kind: string,
    text: string,
    chip-label: string,
    bold: bool,
}

export struct ChecklistPreviewItem {
    line-index: int,
    text: string,
    checked: bool,
}

// Serialized markers are projected into clickable native date labels. This
// model supplies the bounded picker and the non-Windows fallback surface.
export struct DateChipItem {
    occurrence: int,
    date: string,
    label: string,
}

export struct CalendarDay { label: string, date: string, selected: bool, in-month: bool }
export struct CalendarWeek { days: [CalendarDay] }

// Slint 1.9's public TextEdit wraps a native TextInput but does not expose its
// selection offsets. This small local wrapper retains the normal multiline,
// wrapping and keyboard behaviour while making that native selection available
// to the formatting toolbar. Offsets are UTF-8 byte offsets, matching
// TextInput's own editing API.
component SelectionEditor inherits Rectangle {
    in-out property <string> text;
    in property <bool> native-mode: false;
    in property <bool> read-only: false;
    in property <string> placeholder-text;
    in property <color> text-color: #32343d;
    out property <int> cursor-byte-offset: text-input.cursor-position_byte-offset;
    out property <int> anchor-byte-offset: text-input.anchor-position-byte-offset;
    in-out property <int> list-command-offset: -1;
    callback edited(string);
    callback apply-shortcut(string, int, int);
    callback apply-list-command(string, int, int);
    callback escape-pressed();

    public function restore-selection(start: int, end: int) {
        if (!root.native-mode && !root.read-only) {
            text-input.set-selection-offsets(start, end);
            text-input.focus();
        }
    }

    public function apply-list(command: string) {
        root.list-command-offset = -1;
        root.apply-list-command(command, text-input.anchor-position-byte-offset, text-input.cursor-position-byte-offset);
        if (root.list-command-offset >= 0 && !root.native-mode && !root.read-only) {
            text-input.set-selection-offsets(root.list-command-offset, root.list-command-offset);
            text-input.focus();
        }
    }

    scroll-view := ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, text-input.preferred-height);

        text-input := TextInput {
            text: root.native-mode ? "" : root.text;
            width: parent.width;
            wrap: word-wrap;
            single-line: false;
            enabled: !root.read-only;
            color: root.text-color;
            selection-background-color: #7662c999;
            selection-foreground-color: #ffffff;
            edited => { root.text = self.text; root.edited(self.text); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.escape-pressed();
                    return accept;
                }
                if (event.modifiers.control && !event.modifiers.shift && event.text == "b") {
                    root.apply-shortcut("bold", self.anchor-position-byte-offset, self.cursor-position_byte-offset);
                    return accept;
                }
                if (event.modifiers.control && !event.modifiers.shift && event.text == "i") {
                    root.apply-shortcut("italic", self.anchor-position-byte-offset, self.cursor-position_byte-offset);
                    return accept;
                }
                if (event.modifiers.control && !event.modifiers.shift && event.text == "u") {
                    root.apply-shortcut("underline", self.anchor-position-byte-offset, self.cursor-position_byte-offset);
                    return accept;
                }
                if (!event.modifiers.control && !event.modifiers.alt && event.text == Key.Return) {
                    root.list-command-offset = -1;
                    root.apply-list-command("enter", self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                    if (root.list-command-offset >= 0) {
                        self.set-selection-offsets(root.list-command-offset, root.list-command-offset);
                        return accept;
                    }
                }
                reject
            }
        }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text == "" && text-input.preedit-text == "" ? root.placeholder-text : "";
        color: root.text-color;
        vertical-alignment: top;
        wrap: word-wrap;
        accessible-role: none;
    }
}

// A semantic, focusable color target rather than an anonymous hit area. The
// colored rectangle preserves the familiar sticky-note palette while the
// FocusScope supplies Space/Enter activation for keyboard users.
component NoteAction inherits Rectangle {
    in property <bool> action-enabled: true;
    in property <string> text;
    in property <string> label: text;
    in property <color> foreground: #353535;
    in property <bool> emphasis: false;
    in property <bool> italic: false;
    in property <bool> menu-row: false;
    in property <bool> has-icon: false;
    in property <image> icon;
    in property <length> text-size: 16px;
    callback clicked();
    // Hover text for a tooltip: the label on enter, empty on leave or click.
    callback tip(string);
    callback focus-editor();
    in property <bool> keyboard-editor-navigation: false;
    public function focus-action() { keyboard.focus(); }
    min-width: 0px;
    preferred-width: 30px;
    background: hit.has-hover || keyboard.has-focus ? #00000012 : transparent;
    border-width: keyboard.has-focus ? 1px : 0px;
    border-color: foreground;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: action-enabled;
    accessible-action-default => { if (root.action-enabled) { root.clicked(); } }
    forward-focus: keyboard;
    keyboard := FocusScope {
        enabled: root.action-enabled;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (root.keyboard-editor-navigation && event.text == Key.F6) { root.focus-editor(); return accept; }
            if (root.action-enabled && (event.text == Key.Return || event.text == Key.Space)) { root.clicked(); return accept; }
            reject
        }
    }
    hit := TouchArea { enabled: root.action-enabled; width: parent.width; height: parent.height; clicked => { root.tip(""); root.clicked(); } changed has-hover => { root.tip(self.has-hover ? root.label : ""); } }
    Text {
        visible: !root.has-icon || root.menu-row;
        x: root.menu-row ? (root.has-icon ? 48px : 16px) : 0px;
        width: parent.width - self.x;
        height: parent.height;
        text: root.text;
        color: root.foreground;
        font-size: root.text-size;
        font-weight: root.emphasis ? 700 : 400;
        font-italic: root.italic;
        horizontal-alignment: root.menu-row ? left : center;
        vertical-alignment: center;
    }
    Image {
        visible: root.has-icon;
        source: root.icon;
        colorize: root.foreground;
        width: 18px;
        height: 18px;
        x: root.menu-row ? 16px : (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// A titled card on the Settings page.
component SettingsSection inherits Rectangle {
    in property <string> title;
    in property <color> foreground;
    in property <bool> dark;
    background: root.dark ? #2a2d34 : #f4f5f7;
    border-radius: 8px;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text { text: root.title; color: root.foreground; font-size: 13px; font-weight: 600; }
        @children
    }
}

component ColorSwatch inherits Rectangle {
    in property <color> swatch-color;
    in property <string> label;
    in property <bool> selected;
    callback activated();

    background: swatch-color;
    accessible-role: button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { root.activated(); }
    forward-focus: keyboard-focus;

    keyboard-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.activated();
                return accept;
            }
            reject
        }
    }
    TouchArea { width: parent.width; height: parent.height; clicked => { root.activated(); } }
    Rectangle {
        visible: keyboard-focus.has-focus;
        width: parent.width;
        height: parent.height;
        border-width: 2px;
        border-color: root.swatch-color == #777777 ? #ffffff : #1f1f1f;
    }
    // An SVG, not a "✓" glyph: the software renderer's font has no such glyph.
    Image {
        visible: root.selected;
        source: @image-url("icons/check.svg");
        colorize: root.swatch-color == #777777 ? #ffffff : #24252a;
        width: min(parent.width, 16px);
        height: min(parent.height, 16px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        accessible-role: none;
    }
}

// A reminder is deliberately kept separate from a note card. A due date can
// have more than one chip in the same note, and the native surface needs the
// stable projection id when the user completes or dismisses it.
export struct ReminderCard {
    id: string,
    title: string,
    label: string,
    due-label: string,
}

export component BoardWindow inherits Window {
    icon: @image-url("icons/app-icon.png");
    title: "Sticky Notes+";
    preferred-width: 400px;
    preferred-height: 620px;
    min-width: 360px;
    min-height: 440px;
    max-width: 1800px;
    background: root.dark-theme ? #202228 : #ffffff;
    in-out property <int> repaint-epoch: 0;
    in-out property <bool> dark-theme: false;
    in-out property <bool> settings-open: false;
    property <bool> navigation-open: false;
    in-out property <bool> setting-dark: false;
    in-out property <bool> setting-startup: false;
    in-out property <string> setting-shortcut;
    in-out property <string> settings-status;
    property <color> board-foreground: root.dark-theme ? #f1f2f5 : #25262c;
    property <color> board-muted: root.dark-theme ? #b8bdc9 : #6b7080;
    property <color> board-error: root.dark-theme ? #ff8a80 : #ab2e26;
    // Saves preferences; the shortcut field only when include-shortcut is set.
    callback apply-settings(/* include-shortcut */ bool);
    // Google Calendar: one-way push of timed reminders.
    in-out property <bool> calendar-configured: false;
    in-out property <bool> calendar-connected: false;
    in-out property <string> calendar-status: "Not connected.";
    in-out property <bool> calendar-setup-open: false;
    in-out property <bool> calendar-sync-existing: true;
    in-out property <int> calendar-alert-index: 1;
    in-out property <bool> calendar-include-text: true;
    in-out property <bool> calendar-confirm-disconnect: false;
    in-out property <bool> calendar-delete-calendar: false;
    callback calendar-connect();
    callback calendar-save-options();
    callback calendar-sync-now();
    callback calendar-disconnect();
    // Updates: checked only from Settings, installed only when asked.
    in-out property <string> update-version;
    in-out property <string> update-status;
    in-out property <bool> update-available: false;
    in-out property <bool> update-busy: false;
    callback check-for-updates();
    callback install-update();
    callback finish-update(string);
    in-out property <string> export-status;
    // An import or export is running in the background.
    in-out property <bool> data-busy: false;
    callback export-notes();
    in-out property <bool> import-pending: false;
    in-out property <string> import-status;
    callback preview-import();
    callback confirm-import();
    callback cancel-import();
    init => { Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    // Switch the std-widget palette in the same update as our own colours. A
    // `changed` handler ran after the frame was drawn, leaving stale widgets
    // until a resize; the epoch bump then repaints the whole window.
    public function apply-theme(dark: bool) {
        root.dark-theme = dark;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
        root.repaint-epoch = root.repaint-epoch == 0 ? 1 : 0;
    }
    in-out property <[NoteCard]> notes;
    in-out property <[ReminderCard]> due-reminders;
    in-out property <string> query;
    in-out property <string> board-view: "notes";
    property <string> card-menu-id: "";
    in-out property <string> pending-purge-id: "";
    in-out property <bool> reminder-panel-open: false;
    in-out property <string> reminder-error;
    callback search(string);
    callback select-board-view(string);
    callback create-note();
    callback open-note(string);
    callback begin-card-drag(string);
    callback move-card-drag() -> bool;
    callback end-card-drag(bool) -> bool;
    in-out property <bool> note-drop-active: false;
    in-out property <bool> card-drag-active: false;
    in-out property <string> window-status;
    property <bool> card-click-suppressed: false;
    // Which card the pointer pressed, so only that card shows drag feedback.
    property <string> pressed-card-id;
    callback delete-note(string);
    callback archive-note(string, bool);
    callback restore-note(string);
    callback request-purge(string);
    callback confirm-purge(string);
    callback cancel-purge();
    callback toggle-pin(string, bool);
    callback select-color(string, string);
    callback dismiss-reminder(string);
    callback complete-reminder(string);
    callback snooze-reminder(string);

    // The partial renderer does not track the Window's own background, so a
    // theme change or re-show left untouched areas stale. A full-size item is
    // tracked: changing it (or repaint-epoch) repaints the whole window.
    Rectangle {
        width: root.width;
        height: root.height;
        background: root.repaint-epoch < 0 ? #000000 : root.dark-theme ? #202228 : #ffffff;
    }
    VerticalLayout {
        padding: 16px;
        // The list's scrollbar sits in the right margin, not over the cards.
        padding-right: 4px;
        spacing: 12px;
        VerticalLayout {
        padding-right: 12px;
        spacing: 12px;
        vertical-stretch: 0;
        HorizontalLayout {
            spacing: 12px;
            NoteAction { text: "+"; label: "New note"; foreground: root.board-foreground; width: 32px; height: 36px; clicked => { root.create-note(); } }
            Text { text: root.settings-open ? "Settings" : root.note-drop-active ? "Drop note here" : root.card-drag-active ? "Release outside to open" : root.board-view == "archive" ? "Archive" : root.board-view == "deleted" ? "Deleted notes" : "Sticky Notes"; font-size: root.note-drop-active || root.card-drag-active ? 16px : 24px; font-weight: 600; color: root.board-foreground; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.settings-open: Button { text: "Done"; primary: true; clicked => { root.settings-open = false; root.navigation-open = false; root.settings-status = ""; } }
            if !root.settings-open: NoteAction { has-icon: true; icon: @image-url("icons/settings.svg"); label: "Settings and additional views"; foreground: root.board-foreground; width: 36px; height: 36px; clicked => { if (root.settings-open) { root.settings-open = false; root.navigation-open = false; } else { root.navigation-open = !root.navigation-open; } } }
        }
        if !root.settings-open: HorizontalLayout {
            spacing: 8px;
            LineEdit { placeholder-text: "Search…"; text <=> query; edited => { root.search(self.text); } horizontal-stretch: 1; min-width: 0px; }
        }
        if root.navigation-open: VerticalLayout {
            spacing: 0px;
            NoteAction { text: "Notes"; menu-row: true; foreground: root.board-foreground; emphasis: root.board-view == "notes"; height: 32px; clicked => { root.card-menu-id = ""; root.navigation-open = false; root.select-board-view("notes"); } }
            NoteAction { text: "Archive"; menu-row: true; foreground: root.board-foreground; emphasis: root.board-view == "archive"; height: 32px; clicked => { root.card-menu-id = ""; root.navigation-open = false; root.select-board-view("archive"); } }
            NoteAction { text: "Deleted"; menu-row: true; foreground: root.board-foreground; emphasis: root.board-view == "deleted"; height: 32px; clicked => { root.card-menu-id = ""; root.navigation-open = false; root.select-board-view("deleted"); } }
            NoteAction { text: "Reminders"; menu-row: true; foreground: root.board-foreground; height: 32px; clicked => { root.reminder-panel-open = !root.reminder-panel-open; root.navigation-open = false; if (root.reminder-panel-open && root.board-view != "notes") { root.select-board-view("notes"); } } }
            NoteAction { text: "Settings"; menu-row: true; foreground: root.board-foreground; height: 32px; clicked => { root.settings-open = true; root.setting-dark = root.dark-theme; root.settings-status = ""; root.reminder-panel-open = false; root.navigation-open = false; root.check-for-updates(); } }
        }
        if root.reminder-error != "": HorizontalLayout {
            Text { text: root.reminder-error; color: root.board-error; wrap: word-wrap; horizontal-stretch: 1; }
            Button { text: "Dismiss"; clicked => { root.reminder-error = ""; } }
        }
        if root.reminder-panel-open && !root.settings-open && root.board-view == "notes" && due-reminders.length > 0: Rectangle {
            // The board's 440px minimum height always leaves room for this.
            height: 150px;
            background: root.dark-theme ? #3a3322 : #fff7d6;
            border-width: 1px;
            border-color: root.dark-theme ? #8a7434 : #d8bc63;
            border-radius: 10px;
            clip: true;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                HorizontalLayout {
                    Text {
                        text: "Due reminders";
                        font-size: 14px;
                        font-weight: 700;
                        color: root.dark-theme ? #f3dfa0 : #66521b;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    NoteAction { text: "×"; label: "Hide due reminders"; foreground: root.dark-theme ? #f3dfa0 : #66521b; width: 24px; height: 24px; clicked => { root.reminder-panel-open = false; } }
                }
                ScrollView {
                    viewport-width: self.visible-width;
                    VerticalLayout {
                    padding-right: 10px;
                    spacing: 6px;
                    for reminder in due-reminders: Rectangle {
                        height: 72px;
                        min-width: 0px;
                        horizontal-stretch: 1;
                        background: root.dark-theme ? #00000040 : #ffffff99;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: reminder.title == "" ? "Untitled note" : reminder.title;
                                horizontal-stretch: 1;
                                color: root.dark-theme ? #f3dfa0 : #66521b;
                                min-width: 0px;
                                font-size: 13px;
                                font-weight: 700;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            Text {
                                text: reminder.label == "" ? reminder.due-label : reminder.label + " · " + reminder.due-label;
                                horizontal-stretch: 0;
                                color: root.dark-theme ? #e0cf9e : #695b35;
                                min-width: 0px;
                                font-size: 12px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                height: 32px;
                                Button { text: "Done"; min-width: 0px; horizontal-stretch: 1; clicked => { root.complete-reminder(reminder.id); } }
                                Button { text: "Snooze 10m"; min-width: 0px; horizontal-stretch: 1; clicked => { root.snooze-reminder(reminder.id); } }
                                Button { text: "Dismiss"; min-width: 0px; horizontal-stretch: 1; clicked => { root.dismiss-reminder(reminder.id); } }
                            }
                        }
                    }
                    }
                }
            }
        }
        // Message above buttons so both actions stay reachable at minimum width.
        if root.pending-purge-id != "": Rectangle {
            background: root.dark-theme ? #3d2326 : #fff0f0;
            border-width: 1px;
            border-color: root.dark-theme ? #a05a5a : #d98a8a;
            border-radius: 8px;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text {
                    text: "Permanently delete this note? This cannot be undone.";
                    color: root.dark-theme ? #ffb4ab : #7b2727;
                    wrap: word-wrap;
                    font-size: 12px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { text: "Cancel"; clicked => { root.cancel-purge(); } }
                    Button { text: "Delete forever"; clicked => { root.confirm-purge(root.pending-purge-id); } }
                }
            }
        }
        if root.window-status != "": HorizontalLayout {
            Text { text: root.window-status; color: root.board-error; wrap: word-wrap; horizontal-stretch: 1; }
            Button { text: "Dismiss"; clicked => { root.window-status = ""; } }
        }
        if notes.length == 0 && !root.settings-open: Text { text: root.board-view == "notes" ? "No notes yet. Create one to keep a thought close at hand." : root.board-view == "archive" ? "Your archive is empty. Archived notes can always return to Notes." : "Nothing is in Deleted notes. Deleted notes can be restored here."; color: root.board-muted; horizontal-alignment: center; wrap: word-wrap; }
        }
        // Settings replaces the card list; each section is a card.
        if root.settings-open: ScrollView {
            viewport-width: self.visible-width;
            VerticalLayout {
                padding-right: 12px;
                spacing: 12px;
                alignment: start;
                SettingsSection {
                    title: "Appearance";
                    foreground: root.board-foreground;
                    dark: root.dark-theme;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Dark mode"; color: root.board-foreground; vertical-alignment: center; horizontal-stretch: 1; }
                        Switch { checked <=> root.setting-dark; toggled => { root.apply-settings(false); } }
                    }
                }
                SettingsSection {
                    title: "Startup";
                    foreground: root.board-foreground;
                    dark: root.dark-theme;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Start with Windows"; color: root.board-foreground; vertical-alignment: center; horizontal-stretch: 1; }
                        Switch { checked <=> root.setting-startup; toggled => { root.apply-settings(false); } }
                    }
                }
                SettingsSection {
                    title: "Keyboard shortcut";
                    foreground: root.board-foreground;
                    dark: root.dark-theme;
                    Text { text: "Create a new note from anywhere. Takes effect next launch."; color: root.board-muted; wrap: word-wrap; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit { text <=> root.setting-shortcut; placeholder-text: "Ctrl+Alt+N"; horizontal-stretch: 1; min-width: 0px; accepted => { root.apply-settings(true); } }
                        Button { text: "Save"; clicked => { root.apply-settings(true); } }
                    }
                }
                if root.settings-status != "": Text { text: root.settings-status; color: root.board-muted; wrap: word-wrap; }
                SettingsSection {
                    title: "Google Calendar";
                    foreground: root.board-foreground;
                    dark: root.dark-theme;
                Text { text: root.calendar-status; color: root.board-muted; wrap: word-wrap; }
                if root.calendar-configured && !root.calendar-connected && !root.calendar-setup-open: HorizontalLayout {
                    alignment: start;
                    Button { text: "Connect Google Calendar…"; clicked => { root.calendar-setup-open = true; } }
                }
                // First connect: choices, then the browser sign-in.
                if root.calendar-setup-open: VerticalLayout {
                    spacing: 6px;
                    Text { text: "Reminders with a time become events in a new \"Sticky Notes\" calendar, so your phone can alert you."; color: root.board-foreground; wrap: word-wrap; }
                    CheckBox { text: "Add events for my existing timed reminders"; checked <=> root.calendar-sync-existing; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Alert"; color: root.board-foreground; vertical-alignment: center; }
                        ComboBox { model: ["At the reminder time", "10 minutes before", "20 minutes before", "30 minutes before", "1 hour before"]; current-index <=> root.calendar-alert-index; horizontal-stretch: 1; }
                    }
                    CheckBox { text: "Include note text (off sends only the title)"; checked <=> root.calendar-include-text; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Button { text: "Cancel"; clicked => { root.calendar-setup-open = false; } }
                        Button { text: "Continue in browser"; primary: true; clicked => { root.calendar-setup-open = false; root.calendar-connect(); } }
                    }
                }
                if root.calendar-connected && !root.calendar-confirm-disconnect: VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Alert"; color: root.board-foreground; vertical-alignment: center; }
                        ComboBox { model: ["At the reminder time", "10 minutes before", "20 minutes before", "30 minutes before", "1 hour before"]; current-index <=> root.calendar-alert-index; selected => { root.calendar-save-options(); } horizontal-stretch: 1; }
                    }
                    CheckBox { text: "Include note text (off sends only the title)"; checked <=> root.calendar-include-text; toggled => { root.calendar-save-options(); } }
                    Text { text: "Sync is one-way: changes made in Google are replaced when the note changes."; color: root.board-muted; wrap: word-wrap; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button { text: "Sync now"; clicked => { root.calendar-sync-now(); } }
                        Button { text: "Disconnect…"; clicked => { root.calendar-delete-calendar = false; root.calendar-confirm-disconnect = true; } }
                    }
                }
                if root.calendar-connected && root.calendar-confirm-disconnect: VerticalLayout {
                    spacing: 6px;
                    Text { text: "Disconnect Google Calendar? Reminders keep working on this PC."; color: root.board-foreground; wrap: word-wrap; }
                    CheckBox { text: "Also delete the Sticky Notes calendar from Google"; checked <=> root.calendar-delete-calendar; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Button { text: "Cancel"; clicked => { root.calendar-confirm-disconnect = false; } }
                        Button { text: "Disconnect"; clicked => { root.calendar-confirm-disconnect = false; root.calendar-disconnect(); } }
                    }
                }
                }
                SettingsSection {
                    title: "Updates";
                    foreground: root.board-foreground;
                    dark: root.dark-theme;
                    Text { text: root.update-version; color: root.board-muted; font-size: 12px; }
                    if root.update-status != "": Text { text: root.update-status; color: root.board-foreground; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button { text: "Check for updates"; enabled: !root.update-busy; clicked => { root.check-for-updates(); } }
                        if root.update-available: Button { text: "Install update"; primary: true; enabled: !root.update-busy; clicked => { root.install-update(); } }
                    }
                }
                SettingsSection {
                    title: "Data";
                    foreground: root.board-foreground;
                    dark: root.dark-theme;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button { text: "Export notes…"; enabled: !root.data-busy; clicked => { root.export-notes(); } }
                        Button { text: "Import from export…"; enabled: !root.data-busy; clicked => { root.preview-import(); } }
                    }
                    if root.export-status != "": Text { text: root.export-status; color: root.board-muted; wrap: word-wrap; }
                    if root.import-status != "": Text { text: root.import-status; color: root.board-muted; wrap: word-wrap; }
                    if root.import-pending: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button { text: "Add notes"; primary: true; clicked => { root.confirm-import(); } }
                        Button { text: "Cancel"; clicked => { root.cancel-import(); } }
                    }
                }
            }
        }
        if !root.settings-open: ScrollView {
            viewport-width: self.visible-width;
            VerticalLayout {
                padding-right: 12px;
                spacing: 10px;
            for card in notes: Rectangle {
                property <bool> dragging: root.card-drag-active && root.pressed-card-id == card.id;
                property <bool> emphasized: self.dragging || card-keyboard.has-focus;
                clip: true;
                background: card.color;
                opacity: self.dragging ? 0.5 : 1.0;
                border-radius: 3px;
                border-width: self.emphasized ? 2px : 1px;
                border-color: self.emphasized ? root.board-foreground : #00000018;
                horizontal-stretch: 1;
                min-width: 0px;
                height: root.card-menu-id == card.id ? 160px : 120px;
                accessible-role: button;
                accessible-label: card.title;
                accessible-action-default => { if (root.board-view != "deleted") { root.open-note(card.id); } }
                // Tab reaches each card before its ··· button; Enter or Space opens it.
                card-keyboard := FocusScope {
                    enabled: root.board-view != "deleted";
                    width: parent.width;
                    height: parent.height;
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) {
                            root.open-note(card.id);
                            return accept;
                        }
                        reject
                    }
                }
                TouchArea {
                    enabled: root.board-view != "deleted";
                    mouse-cursor: parent.dragging ? MouseCursor.move : MouseCursor.default;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.cancel) {
                            root.card-click-suppressed = root.end-card-drag(true);
                        } else if (event.button == PointerEventButton.left) {
                            if (event.kind == PointerEventKind.down) {
                                root.card-click-suppressed = false;
                                root.pressed-card-id = card.id;
                                root.begin-card-drag(card.id);
                            }
                            if (event.kind == PointerEventKind.up) {
                                root.card-click-suppressed = root.end-card-drag(false);
                            }
                        }
                    }
                    moved => { if (self.pressed) { root.card-click-suppressed = root.move-card-drag(); } }
                    clicked => { if (!root.card-click-suppressed) { root.open-note(card.id); } }
                }
                VerticalLayout {
                    padding: 16px;
                    padding-top: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        Text { text: card.updated-label; color: card.color == #454545 ? #dddddd : #64635e; font-size: 11px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                        if card.pinned: Image { source: @image-url("icons/star.svg"); colorize: card.color == #454545 ? #e0e1e4 : #454854; width: 14px; height: 14px; y: (28px - self.height) / 2; accessible-role: text; accessible-label: "Pinned"; }
                        NoteAction { text: "···"; label: "Options for " + (card.title == "" ? "Untitled note" : card.title); foreground: card.color == #454545 ? #f5f5f6 : #32343d; width: 28px; height: 28px; clicked => { root.card-menu-id = root.card-menu-id == card.id ? "" : card.id; } }
                    }
                    Text { text: card.title; color: card.color == #454545 ? #f5f5f6 : #32343d; font-size: 14px; overflow: elide; }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: card.preview == "" && card.title == "Untitled note" ? "Empty note" : card.preview; color: card.color == #454545 ? #e0e1e4 : #454854; font-size: 14px; overflow: elide; min-width: 0px; }
                        Text { text: card.preview-more; color: card.color == #454545 ? #e0e1e4 : #454854; font-size: 14px; overflow: elide; min-width: 0px; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    if root.card-menu-id == card.id: HorizontalLayout {
                        spacing: 5px;
                        if root.board-view == "notes": NoteAction { text: card.pinned ? "Unpin" : "Pin"; width: 54px; height: 32px; text-size: 13px; foreground: card.color == #454545 ? #f5f5f6 : #32343d; clicked => { root.toggle-pin(card.id, !card.pinned); } }
                        if root.board-view == "notes": NoteAction { text: "Archive"; width: 68px; height: 32px; text-size: 13px; foreground: card.color == #454545 ? #f5f5f6 : #32343d; clicked => { root.archive-note(card.id, true); } }
                        if root.board-view == "archive": NoteAction { text: "Unarchive"; width: 80px; height: 32px; text-size: 13px; foreground: card.color == #454545 ? #f5f5f6 : #32343d; clicked => { root.archive-note(card.id, false); } }
                        if root.board-view == "deleted": NoteAction { text: "Restore"; width: 68px; height: 32px; text-size: 13px; foreground: card.color == #454545 ? #f5f5f6 : #32343d; clicked => { root.restore-note(card.id); } }
                        if root.board-view != "deleted": NoteAction { text: "Delete"; width: 58px; height: 32px; text-size: 13px; foreground: card.color == #454545 ? #f5f5f6 : #32343d; clicked => { root.delete-note(card.id); } }
                        if root.board-view == "deleted": NoteAction { text: "Delete forever"; width: 100px; height: 32px; text-size: 13px; foreground: card.color == #454545 ? #f5f5f6 : #32343d; clicked => { root.request-purge(card.id); } }
                        Rectangle { horizontal-stretch: 1; }
                        if root.board-view != "deleted": ColorSwatch { width: 18px; height: 18px; swatch-color: #ffe66a; label: "Yellow note"; selected: card.color == #fff8ce; activated => { root.select-color(card.id, "#FFF9B1"); } }
                        if root.board-view != "deleted": ColorSwatch { width: 18px; height: 18px; swatch-color: #9bdef9; label: "Blue note"; selected: card.color == #ddf2fc; activated => { root.select-color(card.id, "#DCE8FF"); } }
                        if root.board-view != "deleted": ColorSwatch { width: 18px; height: 18px; swatch-color: #a5eda3; label: "Green note"; selected: card.color == #e2f6d8; activated => { root.select-color(card.id, "#D9F7BE"); } }
                    }
                }
            }
            }
        }
    }
}

// Follows the cursor while a board card is dragged. A new one is created per
// drag and never activated, so the board keeps its pointer capture.
export component DragGhostWindow inherits Window {
    in property <string> title-text;
    in property <color> card-color: #fff8ce;
    no-frame: true;
    always-on-top: true;
    width: 220px;
    height: 56px;
    background: card-color;
    Rectangle { border-width: 1px; border-color: #00000040; }
    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.title-text;
        color: root.card-color == #454545 ? #f5f5f6 : #32343d;
        font-size: 14px;
        overflow: elide;
        vertical-alignment: center;
    }
}

export component NoteWindow inherits Window {
    icon: @image-url("icons/app-icon.png");
    in-out property <bool> frameless: false;
    no-frame: root.frameless;
    always-on-top: root.note-always-on-top;
    title: note-title == "" ? "Sticky Note" : note-title;
    preferred-width: 360px;
    preferred-height: 414px;
    // Keep the native window resizable on every backend. Without explicit
    // lower bounds, the layout's inferred constraints can collapse the
    // horizontal resize range for freshly-created windows in winit.
    min-width: 260px;
    min-height: 180px;
    // Keep the native resize range open in both directions. The layout below
    // contains several fixed-width controls, so relying on its inferred
    // maximum can make winit clamp horizontal growth to the initial width.
    max-width: 1600px;
    // Make the edge hit target explicit for the winit backend. This is
    // especially useful for borderless/theme-dependent window decorations.
    resize-border-width: 8px;
    in-out property <string> note-title;
    in-out property <color> note-color;
    // Keep the selected hex value alongside the rendered color. The Rust
    // persistence layer needs the exact palette value, not a converted color.
    in-out property <string> note-color-value;
    in-out property <string> editor-text;
    in-out property <string> editor-chip-identities: "[]";
    in-out property <bool> native-editor-active: false;
    in-out property <float> native-client-width: 0;
    in-out property <float> native-client-height: 0;
    property <length> content-width: native-client-width > 0 ? min(root.width, native-client-width * 1px) : root.width;
    property <length> content-height: native-client-height > 0 ? min(root.height, native-client-height * 1px) : root.height;
    in-out property <bool> editor-bold;
    // This property started as boldRanges. It now carries all inline style
    // ranges while remaining compatible with older stored JSON arrays.
    in-out property <string> editor-bold-ranges;
    in-out property <int> editor-list-command-offset: -1;
    in-out property <bool> note-always-on-top;
    in-out property <[InlineRun]> inline-runs;
    in-out property <[ChecklistPreviewItem]> checklist-items;
    in-out property <[DateChipItem]> date-chips;
    in-out property <bool> date-panel-open: false;
    in-out property <float> date-anchor-x: 12;
    in-out property <float> date-anchor-y: 44;
    in-out property <string> date-input;
    in-out property <string> date-time-input;
    in-out property <string> date-repeat: "none";
    in-out property <string> date-error;
    in-out property <string> calendar-caption;
    in-out property <int> calendar-year;
    in-out property <int> calendar-month;
    in-out property <[CalendarWeek]> calendar-weeks;
    in-out property <int> date-insert-offset: -1;
    in-out property <string> date-preview-text;
    in-out property <int> selected-date-occurrence: -1;
    // Live logical bounds of the fallback editor, for the native RichEdit
    // host. Keeping this binding in Slint prevents hard-coded placement.
    out property <length> editor-left: note-layout.editor-left;
    out property <length> editor-top: note-layout.editor-top;
    out property <length> editor-width: note-layout.editor-width;
    out property <length> editor-height: note-layout.editor-height;
    property <color> note-foreground: note-color-value == "#6F7078" ? #f5f5f6 : #32343d;
    property <bool> header-pinned: false;
    // Set from Rust while this note's window is the active one.
    in-out property <bool> note-active: false;
    property <bool> show-header: !root.frameless || root.note-active || root.header-pinned || root.overflow-open;
    property <color> header-color: root.note-color-value == "#FFF9B1" ? #fff2a7 : root.note-color-value == "#D9F7BE" ? #c1edb3 : root.note-color-value == "#DCE8FF" ? #bfe7f8 : root.note-color-value == "#E6D8FF" ? #ddc5f2 : root.note-color-value == "#FFD7E5" ? #f7c4df : root.note-color-value == "#6F7078" ? #555555 : #e1e1e1;
    property <bool> overflow-open: false;
    in-out property <string> format-status;
    in-out property <string> save-status;
    property <bool> save-error: root.save-status != "" && root.save-status != "Saved" && root.save-status != "Saving…";
    in-out property <image> attachment-preview;
    in-out property <string> attachment-id;
    in-out property <string> attachment-caption;
    in-out property <int> attachment-index: 0;
    in-out property <int> attachment-count: 0;
    in-out property <bool> inline-image-mode: false;
    in-out property <bool> attachment-remove-pending: false;
    callback add-image();
    callback browse-image(int);
    callback remove-image();
    callback save(string, bool, string);
    callback create-note();
    callback begin-drag();
    callback move-drag();
    callback end-drag(bool);
    callback close-note();
    callback open-board();
    callback return-to-board();
    callback choose-color(string);
    callback insert-date-chip();
    callback toggle-date-panel();
    callback set-native-editor-visible(bool);
    callback focus-native-editor();
    public function focus-toolbar() { bold-action.focus-action(); }
    callback editor-history-action(bool);
    callback toolbar-tip(string);
    in-out property <[string]> week-labels: ["M", "T", "W", "T", "F", "S", "S"];
    callback select-date-occurrence(int);
    callback apply-date-selection();
    callback remove-selected-date();
    callback dismiss-date-panel();
    callback move-calendar-month(int);
    callback pick-calendar-day(string);
    callback toggle-selection-style(string, int, int);
    callback apply-list-command(string, int, int);
    callback editor-text-edited(string);
    callback toggle-always-on-top();
    callback toggle-checklist(int, bool);
    callback delete-note();
    changed date-panel-open => { if (root.date-panel-open) { date-keyboard.focus(); } }
    background: note-color;
    // A compact sticky-note surface. The thin hit target keeps the header
    // discoverable without permanently taking space from the note body. A
    // click pins it open for touch users, where hover is unavailable.
    // The popup takes focus as soon as it opens. Child controls retain normal
    // tab navigation and unhandled Escape bubbles back to this scope.
    menu-keyboard := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape && root.overflow-open) {
                root.overflow-open = false;
                root.set-native-editor-visible(true);
                return accept;
            }
            reject
        }
    }
    note-layout := VerticalLayout {
        width: root.content-width;
        height: root.content-height;
        out property <length> editor-left: self.x + editor-surface.x + 10px;
        out property <length> editor-top: self.y + editor-surface.y + 10px;
        out property <length> editor-width: max(0px, editor-surface.width - 20px);
        out property <length> editor-height: max(0px, editor-surface.height - 20px);
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 0px;
        Rectangle {
            height: 32px;
            // Hidden controls are clipped away, which also keeps them from
            // taking clicks.
            clip: true;
            // The drag strip stays in place whether or not the header shows.
            TouchArea {
                width: parent.width;
                height: parent.height;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.cancel) {
                        root.end-drag(true);
                    } else if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) { root.begin-drag(); }
                        if (event.kind == PointerEventKind.up) { root.end-drag(false); }
                    }
                }
                moved => { if (self.pressed) { root.move-drag(); } }
            }
            // Drops down when the note is clicked into, like Windows
            // Sticky Notes. Its gap lets drags reach the strip underneath.
            Rectangle {
                y: root.show-header ? 0px : -parent.height;
                animate y { duration: 110ms; easing: ease-out; }
                width: parent.width;
                height: parent.height;
                background: root.header-color;
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 4px;
                    spacing: 4px;
                    NoteAction { foreground: root.note-foreground; text: "+"; label: "New note"; width: 28px; clicked => { root.create-note(); } }
                    Rectangle { horizontal-stretch: 1; }
                    NoteAction { foreground: root.note-foreground; text: "···"; label: "Note options"; width: 30px; clicked => { root.overflow-open = !root.overflow-open; root.set-native-editor-visible(!root.overflow-open); if (root.overflow-open) { menu-keyboard.focus(); } } }
                    NoteAction { foreground: root.note-foreground; text: "×"; label: "Close note"; width: 28px; clicked => { root.close-note(); } }
                }
            }
        }
        editor-surface := Rectangle {
            vertical-stretch: 1;
            // The colored sticky itself is the writing surface, not a card
            // containing another card.
            background: #00000000;
            border-width: 0px;
            editor-input := SelectionEditor {
                // Do not render a second text editor beneath the child HWND.
                // Retain its snapshot as context while canvas overlays are open.
                visible: !root.native-editor-active || root.date-panel-open || root.overflow-open;
                native-mode: root.native-editor-active && !root.date-panel-open && !root.overflow-open;
                read-only: root.native-editor-active || root.inline-image-mode;
                // Same 10px inset as the native editor bounds; Rectangle has no padding.
                x: 10px;
                y: 10px;
                width: parent.width - 20px;
                height: parent.height - 20px;
                text: root.native-editor-active || root.inline-image-mode ? root.date-preview-text : root.editor-text;
                text-color: root.note-foreground;
                placeholder-text: "Write a note…\nUse [ ] for checklist items.";
                edited => { root.editor-text = self.text; root.editor-text-edited(self.text); }
                escape-pressed => {
                    if (root.overflow-open) {
                        root.overflow-open = false;
                        root.set-native-editor-visible(true);
                    }
                }
                apply-shortcut(style, anchor, cursor) => {
                    root.toggle-selection-style(style, anchor, cursor);
                    self.restore-selection(anchor, cursor);
                }
                apply-list-command(command, anchor, cursor) => {
                    root.editor-list-command-offset = -1;
                    root.apply-list-command(command, anchor, cursor);
                    self.list-command-offset = root.editor-list-command-offset;
                }
            }
        }
        // Conditional creation removes this preview's layout constraints too;
        // merely hiding it still reserves its height in the vertical layout.
        if !root.native-editor-active && !root.inline-image-mode && checklist-items.length > 0: Rectangle {
            background: root.note-color-value == "#6F7078" ? #00000025 : #ffffff75;
            border-width: 1px;
            border-color: #00000018;
            border-radius: 0px;
            min-height: 30px;
            VerticalLayout {
                padding: 7px;
                spacing: 4px;
                for item in checklist-items: HorizontalLayout {
                    spacing: 6px;
                    CheckBox {
                        checked: item.checked;
                        toggled => { root.toggle-checklist(item.line-index, self.checked); }
                    }
                    Text { text: item.text; color: item.checked ? (root.note-color-value == "#6F7078" ? #dddddf : #777760) : root.note-foreground; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                }
            }
        }
        if root.attachment-count > 0 && !root.native-editor-active: Rectangle {
            height: 72px;
            background: #ffffff55;
            border-radius: 6px;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                Image { source: root.attachment-preview; image-fit: contain; width: 70px; }
                VerticalLayout {
                    Text { height: 18px; text: root.attachment-caption; color: root.note-foreground; overflow: elide; font-size: 11px; min-width: 0px; }
                    HorizontalLayout {
                        height: 28px;
                        spacing: 2px;
                        Button { visible: !root.attachment-remove-pending; text: "‹"; min-width: 0px; preferred-width: 24px; enabled: root.attachment-count > 1; clicked => { root.browse-image(-1); } }
                        Button { visible: !root.attachment-remove-pending; text: "›"; min-width: 0px; preferred-width: 24px; enabled: root.attachment-count > 1; clicked => { root.browse-image(1); } }
                        Button { visible: !root.inline-image-mode; text: root.attachment-remove-pending ? "Delete" : "Remove"; min-width: 0px; clicked => { if (root.attachment-remove-pending) { root.remove-image(); } else { root.attachment-remove-pending = true; } } }
                        Button { visible: root.attachment-remove-pending; text: "×"; min-width: 0px; preferred-width: 24px; clicked => { root.attachment-remove-pending = false; } }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
        // Inset to line up with the note text and toolbar.
        if root.format-status != "": HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            Text {
                text: root.format-status;
                font-size: 10px;
                color: root.note-foreground;
                overflow: elide;
            }
        }
        Rectangle {
            height: root.save-error ? 62px : 40px;
            // Shown and hidden with the header, without animation, as on Windows.
            // Hidden, it keeps its space so the text doesn't reflow.
            clip: true;
            Rectangle {
                y: root.show-header || root.save-error ? 0px : parent.height;
                width: parent.width;
                height: parent.height;
                background: #ffffff12;
                border-radius: 0px;
                // Divider along the top edge; without y Slint centres it over the icons.
                Rectangle { y: 0px; height: 1px; width: parent.width; background: #00000018; }
                VerticalLayout {
                    spacing: 0px;
                HorizontalLayout {
                    height: 40px;
                    padding-left: 4px;
                    spacing: 0px;
                    bold-action := NoteAction { tip(text) => { root.toolbar-tip(text); } keyboard-editor-navigation: root.native-editor-active; focus-editor => { root.focus-native-editor(); } action-enabled: !root.inline-image-mode || root.native-editor-active; foreground: root.note-foreground; text: "B"; label: "Bold"; emphasis: true; width: 32px; clicked => { root.toggle-selection-style("bold", editor-input.anchor-byte-offset, editor-input.cursor-byte-offset); editor-input.restore-selection(editor-input.anchor-byte-offset, editor-input.cursor-byte-offset); } }
                    NoteAction { tip(text) => { root.toolbar-tip(text); } keyboard-editor-navigation: root.native-editor-active; focus-editor => { root.focus-native-editor(); } action-enabled: !root.inline-image-mode || root.native-editor-active; foreground: root.note-foreground; text: "I"; italic: true; label: "Italic"; width: 32px; clicked => { root.toggle-selection-style("italic", editor-input.anchor-byte-offset, editor-input.cursor-byte-offset); editor-input.restore-selection(editor-input.anchor-byte-offset, editor-input.cursor-byte-offset); } }
                    NoteAction { tip(text) => { root.toolbar-tip(text); } keyboard-editor-navigation: root.native-editor-active; focus-editor => { root.focus-native-editor(); } action-enabled: !root.inline-image-mode || root.native-editor-active; foreground: root.note-foreground; has-icon: true; icon: @image-url("icons/underline.svg"); label: "Underline"; width: 32px; clicked => { root.toggle-selection-style("underline", editor-input.anchor-byte-offset, editor-input.cursor-byte-offset); editor-input.restore-selection(editor-input.anchor-byte-offset, editor-input.cursor-byte-offset); } }
                    NoteAction { tip(text) => { root.toolbar-tip(text); } keyboard-editor-navigation: root.native-editor-active; focus-editor => { root.focus-native-editor(); } action-enabled: !root.inline-image-mode || root.native-editor-active; foreground: root.note-foreground; has-icon: true; icon: @image-url("icons/strikethrough.svg"); label: "Strikethrough"; width: 32px; clicked => { root.toggle-selection-style("strike", editor-input.anchor-byte-offset, editor-input.cursor-byte-offset); editor-input.restore-selection(editor-input.anchor-byte-offset, editor-input.cursor-byte-offset); } }
                    NoteAction { tip(text) => { root.toolbar-tip(text); } keyboard-editor-navigation: root.native-editor-active; focus-editor => { root.focus-native-editor(); } action-enabled: !root.inline-image-mode || root.native-editor-active; foreground: root.note-foreground; has-icon: true; icon: @image-url("icons/list.svg"); label: "Bullet list"; width: 32px; clicked => { editor-input.apply-list("bullet"); } }
                    NoteAction { tip(text) => { root.toolbar-tip(text); } keyboard-editor-navigation: root.native-editor-active; focus-editor => { root.focus-native-editor(); } action-enabled: !root.inline-image-mode || root.native-editor-active; foreground: root.note-foreground; has-icon: true; icon: @image-url("icons/image.svg"); label: "Add image"; width: 32px; clicked => { root.add-image(); } }
                    NoteAction { tip(text) => { root.toolbar-tip(text); } keyboard-editor-navigation: root.native-editor-active; focus-editor => { root.focus-native-editor(); } action-enabled: !root.inline-image-mode || root.native-editor-active; foreground: root.note-foreground; has-icon: true; icon: @image-url("icons/checklist.svg"); label: "Checklist"; width: 32px; clicked => { editor-input.apply-list("checklist"); } }
                    NoteAction { tip(text) => { root.toolbar-tip(text); } keyboard-editor-navigation: root.native-editor-active; focus-editor => { root.focus-native-editor(); } action-enabled: !root.inline-image-mode || root.native-editor-active; foreground: root.note-foreground; has-icon: true; icon: @image-url("icons/calendar.svg"); label: "Date picker"; width: 32px; clicked => { root.toggle-date-panel(); } }
                    Rectangle { horizontal-stretch: 1; }
                    // Only where they fit beside the other tools at narrow widths.
                    if root.native-editor-active && root.native-client-width >= 324: NoteAction { tip(text) => { root.toolbar-tip(text); } keyboard-editor-navigation: true; focus-editor => { root.focus-native-editor(); } foreground: root.note-foreground; has-icon: true; icon: @image-url("icons/undo.svg"); label: "Undo"; width: 32px; clicked => { root.editor-history-action(false); } }
                    if root.native-editor-active && root.native-client-width >= 324: NoteAction { tip(text) => { root.toolbar-tip(text); } keyboard-editor-navigation: true; focus-editor => { root.focus-native-editor(); } foreground: root.note-foreground; has-icon: true; icon: @image-url("icons/redo.svg"); label: "Redo"; width: 32px; clicked => { root.editor-history-action(true); } }
                }
                if root.save-error: HorizontalLayout {
                    height: 22px;
                    Text { text: root.save-status; color: root.note-foreground; font-size: 10px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    NoteAction { text: "Retry"; label: "Retry saving note"; text-size: 11px; foreground: root.note-foreground; width: 48px; clicked => { root.save(editor-text, editor-bold, editor-bold-ranges); } }
                }
                }
            }
        }
    }
    // This is an overlay, not a layout child: opening it never moves the
    // editor or the bottom toolbar. The full-width menu mirrors Windows
    // Sticky Notes and gives each color a large, keyboard-reachable target.
    // Starts below the 32px header so "+", "···" and × stay usable.
    if root.overflow-open: Rectangle {
        y: 32px;
        width: parent.width;
        height: parent.height - 32px;
        background: #00000000;
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.overflow-open = false; root.set-native-editor-visible(true); }
        }
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: min(171px, parent.height);
            background: #ffffff;
            border-width: 1px;
            border-color: #00000024;
            TouchArea { width: parent.width; height: parent.height; }
            // Focus lands on the first swatch, not the header behind the menu,
            // and Escape from any menu control bubbles up to this scope.
            init => { first-swatch.focus(); }
            FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.overflow-open = false;
                        root.set-native-editor-visible(true);
                        return accept;
                    }
                    reject
                }
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    height: 50px;
                    spacing: 0px;
                    first-swatch := ColorSwatch { horizontal-stretch: 1; label: "Yellow"; swatch-color: #ffe66a; selected: root.note-color-value == "#FFF9B1"; activated => { root.choose-color("#FFF9B1"); root.overflow-open = false; root.set-native-editor-visible(true); } }
                    ColorSwatch { horizontal-stretch: 1; label: "Green"; swatch-color: #a5eda3; selected: root.note-color-value == "#D9F7BE"; activated => { root.choose-color("#D9F7BE"); root.overflow-open = false; root.set-native-editor-visible(true); } }
                    ColorSwatch { horizontal-stretch: 1; label: "Pink"; swatch-color: #f9afdb; selected: root.note-color-value == "#FFD7E5"; activated => { root.choose-color("#FFD7E5"); root.overflow-open = false; root.set-native-editor-visible(true); } }
                    ColorSwatch { horizontal-stretch: 1; label: "Purple"; swatch-color: #d4adf7; selected: root.note-color-value == "#E6D8FF"; activated => { root.choose-color("#E6D8FF"); root.overflow-open = false; root.set-native-editor-visible(true); } }
                    ColorSwatch { horizontal-stretch: 1; label: "Blue"; swatch-color: #9bdef9; selected: root.note-color-value == "#DCE8FF"; activated => { root.choose-color("#DCE8FF"); root.overflow-open = false; root.set-native-editor-visible(true); } }
                    ColorSwatch { horizontal-stretch: 1; label: "Light grey"; swatch-color: #dedede; selected: root.note-color-value == "#E9E9E9"; activated => { root.choose-color("#E9E9E9"); root.overflow-open = false; root.set-native-editor-visible(true); } }
                    ColorSwatch { horizontal-stretch: 1; label: "Dark grey"; swatch-color: #777777; selected: root.note-color-value == "#6F7078"; activated => { root.choose-color("#6F7078"); root.overflow-open = false; root.set-native-editor-visible(true); } }
                }
                Rectangle { height: 1px; background: #dedbd4; }
                NoteAction { text: "Notes list"; has-icon: true; icon: @image-url("icons/list.svg"); menu-row: true; label: "Notes list"; height: 40px; clicked => { root.open-board(); root.overflow-open = false; root.set-native-editor-visible(true); } }
                // The check marks the current state; the menu stays open so the
                // change is visible.
                NoteAction { text: "Keep on top"; has-icon: true; icon: root.note-always-on-top ? @image-url("icons/check.svg") : @image-url(""); menu-row: true; label: root.note-always-on-top ? "Keep on top, on" : "Keep on top, off"; height: 40px; clicked => { root.toggle-always-on-top(); } }
                NoteAction { text: "Delete note"; has-icon: true; icon: @image-url("icons/trash.svg"); menu-row: true; label: "Delete note"; foreground: #d93025; height: 40px; clicked => { root.delete-note(); root.overflow-open = false; root.set-native-editor-visible(true); } }
            }
            }
        }
    }
    // This sits above the editor rather than consuming layout height. Its
    // transparent TouchArea is a real click-away layer; the panel itself is
    // stacked later and absorbs its own background clicks, leaving inputs and
    // buttons usable while every other note click dismisses it.
    date-keyboard := FocusScope {
        visible: root.date-panel-open;
        width: root.content-width;
        height: root.content-height;
        key-pressed(event) => { if (event.text == Key.Escape && root.date-panel-open) { root.dismiss-date-panel(); return accept; } reject }
    if root.date-panel-open: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000000;
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.dismiss-date-panel(); }
        }
        Rectangle {
            x: max(8px, min(root.date-anchor-x * 1px, parent.width - self.width - 8px));
            y: max(8px, min(root.date-anchor-y * 1px + 16px, parent.height - 74px - self.height - 8px));
            width: min(290px, parent.width - 16px);
            // Keep the toolbar/date toggle reachable while this surface is
            // open. Very small notes scroll the picker instead of covering it.
            height: min(326px, max(60px, parent.height - 60px));
        Rectangle {
            width: parent.width; height: parent.height;
            background: #ffffff;
            border-width: 1px;
            border-color: #00000025;
            border-radius: 4px;
            // Consume clicks in the panel's non-control gaps, so only actual
            // click-away targets dismiss the surface.
            TouchArea { width: parent.width; height: parent.height; }
            ScrollView {
                width: parent.width; height: parent.height;
                viewport-width: self.visible-width;
            // Compact layout: month, days, time + repeat, action. Fits the
            // default note without scrolling; the calendar is the date input.
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 2px;
                    NoteAction { text: "‹"; label: "Previous month"; width: 28px; height: 28px; clicked => { root.move-calendar-month(-1); } }
                    Text { text: root.calendar-caption; font-size: 14px; font-weight: 600; color: #25262c; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
                    NoteAction { text: "›"; label: "Next month"; width: 28px; height: 28px; clicked => { root.move-calendar-month(1); } }
                    NoteAction { text: "×"; label: "Close date picker"; width: 28px; height: 28px; clicked => { root.dismiss-date-panel(); } }
                }
                VerticalLayout {
                    spacing: 0px;
                    HorizontalLayout {
                        for label in root.week-labels: Text { text: label; horizontal-stretch: 1; horizontal-alignment: center; color: #6b7080; font-size: 10px; }
                    }
                    for week in root.calendar-weeks: HorizontalLayout {
                        for day in week.days: Rectangle {
                            min-width: 0px; preferred-width: 34px; horizontal-stretch: 1; height: 26px;
                            Rectangle { x: (parent.width - self.width) / 2; width: 24px; height: 24px; border-radius: 12px; background: day.selected ? #ffe66a : transparent; }
                            NoteAction { text: day.label; label: day.date; foreground: day.in-month ? #323232 : #aaaaaa; width: parent.width; height: parent.height; text-size: 12px; clicked => { root.pick-calendar-day(day.date); } }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit { text <=> root.date-time-input; placeholder-text: "Time (14:30)"; accessible-label: "Time (optional)"; width: 104px; }
                    ComboBox {
                        model: ["Doesn't repeat", "Daily", "Weekly", "Monthly"];
                        accessible-label: "Repeat";
                        current-index: root.date-repeat == "daily" ? 1 : root.date-repeat == "weekly" ? 2 : root.date-repeat == "monthly" ? 3 : 0;
                        selected => { root.date-repeat = self.current-index == 1 ? "daily" : self.current-index == 2 ? "weekly" : self.current-index == 3 ? "monthly" : "none"; }
                        horizontal-stretch: 1;
                        min-width: 0px;
                    }
                }
                Text { visible: root.date-error != ""; text: root.date-error; color: #ab2e26; wrap: word-wrap; font-size: 10px; }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;
                    Button { visible: selected-date-occurrence >= 0; text: "Remove"; clicked => { root.remove-selected-date(); } }
                    Button { text: selected-date-occurrence >= 0 ? "Update" : "Add date"; primary: true; clicked => { root.apply-date-selection(); } }
                }
            }
            }
        }
            }
    }
    }
    // Toolbar and header controls reach the window edges and would reset the
    // pointer to an arrow, hiding Winit's resize cursor. These strips sit on
    // top and show it; the resize itself is still handled by Winit.
    if root.frameless: Rectangle {
        property <length> edge: root.resize-border-width;
        TouchArea { x: 0; y: parent.edge; width: parent.edge; height: root.height - 2 * parent.edge; mouse-cursor: w-resize; }
        TouchArea { x: root.width - parent.edge; y: parent.edge; width: parent.edge; height: root.height - 2 * parent.edge; mouse-cursor: e-resize; }
        TouchArea { x: parent.edge; y: 0; width: root.width - 2 * parent.edge; height: parent.edge; mouse-cursor: n-resize; }
        TouchArea { x: parent.edge; y: root.height - parent.edge; width: root.width - 2 * parent.edge; height: parent.edge; mouse-cursor: s-resize; }
        TouchArea { x: 0; y: 0; width: parent.edge; height: parent.edge; mouse-cursor: nw-resize; }
        TouchArea { x: root.width - parent.edge; y: 0; width: parent.edge; height: parent.edge; mouse-cursor: ne-resize; }
        TouchArea { x: 0; y: root.height - parent.edge; width: parent.edge; height: parent.edge; mouse-cursor: sw-resize; }
        TouchArea { x: root.width - parent.edge; y: root.height - parent.edge; width: parent.edge; height: parent.edge; mouse-cursor: se-resize; }
    }
}

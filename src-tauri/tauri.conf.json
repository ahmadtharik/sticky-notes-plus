{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "sticky-notes-plus",
  "version": "0.1.0",
  "identifier": "com.sticky-notes.app",
  "build": {
    "frontendDist": "src",
    "devUrl": "http://localhost:1420/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "board",
        "title": "Sticky Notes+",
        "width": 1100,
        "height": 750,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
